# Copy outside the source tree to /etc/stacksignal/bot.env, root:stacksignal 0640.
# Generate the webhook secret with: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_APP_ORIGIN=https://stacksignal.stacksignal-idoheled.workers.dev
# Resolve the actual destination after QR pairing; never use the invite token here.
WHATSAPP_GROUP_JID=
OLLAMA_MODEL=qwen3:4b

# Enable only after the pinned group boundary is installed and verified.
COLUMBUS_ENABLED=false
COLUMBUS_ACTIVATED_AT=
